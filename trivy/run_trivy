#!/bin/bash 


cd $(dirname $0)
cd ..
./install_xtreme --ns foo --release foo --dev --dry-run | helm_grep_images > trivy/images
cd trivy
rm -f *json *txt
ct=0

runtrivy="docker-run --self trivy-runner:0.76.1"

for image in $(cat images); do
    let ct++
    json=$(printf report%02d.json $ct)
    txt=$(printf report%02d.txt $ct)
    echo $image $json $txt ...
    docker pull $image

    $runtrivy image --scanners vuln --severity HIGH,CRITICAL  --ignore-unfixed   \
    --skip-files "**/bundle.js" --skip-files "**/*pb-c.h" --skip-files "**/*ypbc.h" --skip-files "**/*vapi" --skip-files "**/*gir" \
    --timeout 15m \
    --exit-code 0 --format json $image >$json

    test -s $json || exit 1

    $runtrivy convert --scanners vuln --format table --output $txt $json 

    test -s $txt || exit 
done
