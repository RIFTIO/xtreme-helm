
cd $(dirname $0)
cd ..
./install_xtreme --ns foo --release foo --dev --dry-run | helm_grep_images > trivy/images
cd trivy
rm -f *json *txt
ct=0

for image in $(cat images); do
    let ct++
    json=$(printf report%02d.json $ct)
    txt=$(printf report%02d.txt $ct)
    echo $image $json $txt ...
    docker-run --self --no-docker trivy-runner:0.62.0   \
    image   \
    --severity HIGH,CRITICAL   \
    --ignore-unfixed   \
    --skip-files "**/bundle.js" \
    --skip-files "**/*pb-c.h"\
    --skip-files "**/*ypbc.h"\
    --skip-files "**/*vapi"\
    --skip-files "**/*gir"\
    --exit-code 0   \
    --format json  \
    $image >$json
    docker-run --self --no-docker trivy-runner:0.62.0   \
    convert   \
    --format table  \
    --output $txt   \
    $json
done
