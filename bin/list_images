#!/usr/bin/env bash
#
# list_images — regenerate the list of container images used by a --prod install
#
#   list_images [-o <file>]
#
#     Renders the chart the way install_xtreme --prod does (xtreme/aeo-values.yaml,
#     repos.yaml, storage.yaml) and writes every image it references, in two groups:
#     images created or maintained by Zhone (dzscloudadmin/*), then third-party images.
#     Third-party names are fully qualified with their registry (docker.io/ if none).
#     The Kafka broker image is not in the render (the Strimzi operator starts the
#     brokers), so it is looked up from the Kafka CR version and STRIMZI_KAFKA_IMAGES.
#
#     -o <file>   output file (default: images in the repo root; - for stdout)
#
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
repo="$script_dir/.."
out="$repo/images"

while [ "$#" -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2;;
    -h|--help) sed -n '3,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
    *) echo "usage: $(basename "$0") [-o <file>]" >&2; exit 1;;
  esac
done

rendered=$(cd "$repo" && helm template xtreme xtreme \
  -f xtreme/aeo-values.yaml -f repos.yaml -f storage.yaml \
  --set global.namespace.name=demo --set global.dockerhubToken=dummy)

images=$(grep -E '^[[:space:]]*-?[[:space:]]*image:' <<<"$rendered" \
  | sed -E 's/^[[:space:]]*-?[[:space:]]*image:[[:space:]]*//; s/["'\'']//g; s/[[:space:]]+$//')

# Kafka broker image: spec.kafka.version of the Kafka CR, mapped through STRIMZI_KAFKA_IMAGES
kafka_version=$(awk '/^kind: Kafka$/ {k=1} k && /^[[:space:]]+version:/ {print $2; exit}' <<<"$rendered")
if [ -z "$kafka_version" ]; then
  echo "error: no Kafka CR version found in the render" >&2
  exit 1
fi
kafka_image=$(grep -m1 -E "^[[:space:]]*${kafka_version//./\\.}=" <<<"$rendered" | sed -E 's/^[[:space:]]*[^=]+=//')
if [ -z "$kafka_image" ]; then
  echo "error: no STRIMZI_KAFKA_IMAGES entry for Kafka $kafka_version" >&2
  exit 1
fi
images=$(printf '%s\n%s\n' "$images" "$kafka_image")

# prefix docker.io/ when the first path component is not a registry host
qualify() {
  awk -F/ '{ if (NF > 1 && ($1 ~ /[.:]/ || $1 == "localhost")) print; else print "docker.io/" $0 }'
}

sort_list() { LC_ALL=en_US.UTF-8 sort -u; }

zhone=$(grep -E '^dzscloudadmin/' <<<"$images" | sort_list)
third_party=$(grep -vE '^dzscloudadmin/' <<<"$images" | qualify | sort_list)

{
  echo "# Images created or maintained by Zhone"
  echo
  echo "$zhone"
  echo
  echo "# Third party containers that this solution leverages"
  echo
  echo "$third_party"
} > "$( [ "$out" = "-" ] && echo /dev/stdout || echo "$out" )"
