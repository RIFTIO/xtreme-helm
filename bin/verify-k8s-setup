#!/bin/bash
# verify-k3s-setup
# K8s-level checks run locally via kubectl.
# Host-level checks run inside a privileged pod on the node so this script
# works from any machine with a valid kubeconfig.

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

K8S_PASS=0; K8S_FAIL=0; K8S_WARN=0

pass()    { echo -e "  ${GREEN}PASS${NC} $1"; K8S_PASS=$((K8S_PASS+1)); }
fail()    { echo -e "  ${RED}FAIL${NC} $1"; K8S_FAIL=$((K8S_FAIL+1)); }
warn()    { echo -e "  ${YELLOW}WARN${NC} $1"; K8S_WARN=$((K8S_WARN+1)); }
section() { echo -e "\n${CYAN}=== $1 ===${NC}"; }

NODE=""
ALL_NODES=""
NAMESPACE="default"
IMAGE="alpine:latest"

usage() {
    echo "Usage: $0 [--node <nodename>] [--all-nodes] [--namespace <ns>] [--image <img>]"
    echo "  --node       Run on a specific node"
    echo "  --all-nodes  Run on every node in the cluster"
    echo "  --namespace  Kubernetes namespace for the pod (default: default)"
    echo "  --image      Container image (default: alpine:latest)"
    exit 1
}

while [[ $# -gt 0 ]]; do
    case $1 in
        --node)       NODE="$2";      shift 2 ;;
        --all-nodes)  ALL_NODES=1;    shift   ;;
        --namespace)  NAMESPACE="$2"; shift 2 ;;
        --image)      IMAGE="$2";     shift 2 ;;
        -h|--help)    usage ;;
        *) echo "Unknown option: $1"; usage ;;
    esac
done

SUFFIX=$(tr -dc 'a-z0-9' </dev/urandom 2>/dev/null | head -c 6 || printf '%06d' "$$")
CM_NAME="k3s-verify-${SUFFIX}"
TMPDIR_INNER=$(mktemp -d)
CREATED_PODS=()

cleanup() {
    for p in "${CREATED_PODS[@]}"; do
        kubectl delete pod "$p" -n "$NAMESPACE" --ignore-not-found=true &>/dev/null || true
    done
    kubectl delete configmap "$CM_NAME" -n "$NAMESPACE" --ignore-not-found=true &>/dev/null || true
    rm -rf "$TMPDIR_INNER"
}
trap cleanup EXIT

# ── K8s-level checks (run locally) ───────────────────────────────────────────

section "kubectl Connectivity"
if kubectl cluster-info &>/dev/null; then
    pass "kubectl can reach the API server"
else
    fail "kubectl cannot reach the API server — check KUBECONFIG"
    exit 1
fi

section "Node Readiness"
mapfile -t node_lines < <(kubectl get nodes --no-headers 2>/dev/null)
total=${#node_lines[@]}
not_ready=0
for line in "${node_lines[@]}"; do
    echo "        $line"
    status=$(awk '{print $2}' <<<"$line")
    [ "$status" != "Ready" ] && not_ready=$((not_ready+1))
done
if [ "$total" -eq 0 ]; then
    fail "No nodes found in cluster"
elif [ "$not_ready" -eq 0 ]; then
    pass "All $total node(s) are Ready"
else
    fail "$not_ready of $total node(s) are NOT Ready"
fi

section "Disabled Components"
if kubectl get pod -n kube-system -l app.kubernetes.io/name=traefik --no-headers 2>/dev/null | grep -q .; then
    fail "traefik pods found in kube-system — should be disabled"
else
    pass "traefik is not running (disabled as expected)"
fi

if kubectl get pod -n kube-system --no-headers 2>/dev/null | awk '{print $1}' | grep -q '^svclb-'; then
    fail "servicelb (svclb) pods found — should be disabled"
else
    pass "servicelb is not running (disabled as expected)"
fi

section "Helm"
if command -v helm &>/dev/null; then
    helm_ver=$(helm version --short 2>/dev/null)
    pass "Helm is installed: $helm_ver"
else
    fail "Helm is NOT installed"
fi

# ── Host-level checks via privileged pod ─────────────────────────────────────

echo ""
echo -e "${CYAN}Launching privileged pod for host-level checks...${NC}"

# Write the inner script to a temp file; single-quoted heredoc so no
# outer-shell expansion occurs — the inner script is pure POSIX sh.
cat >"${TMPDIR_INNER}/verify.sh" <<'INNER_SCRIPT'
#!/bin/sh
# Runs inside a privileged pod.
#   hostPID:true     -> /proc shows host processes and kernel parameters
#   hostNetwork:true -> /proc/net/* reflects the host network stack
#   /host/etc        -> hostPath mount of the node's /etc

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'
PASS=0; FAIL=0; WARN=0

pass()    { printf "  ${GREEN}PASS${NC} %s\n" "$1"; PASS=$((PASS+1)); }
fail()    { printf "  ${RED}FAIL${NC} %s\n" "$1"; FAIL=$((FAIL+1)); }
warn()    { printf "  ${YELLOW}WARN${NC} %s\n" "$1"; WARN=$((WARN+1)); }
section() { printf "\n${CYAN}=== %s ===${NC}\n" "$1"; }

# Read a sysctl value from /proc/sys without needing the sysctl binary
read_sysctl() { cat "/proc/sys/$(echo "$1" | tr '.' '/')" 2>/dev/null; }

check_sysctl_min() {
    key="$1"; min="$2"
    val=$(read_sysctl "$key")
    if [ -z "$val" ]; then
        fail "$key: not found"
    elif [ "$val" -ge "$min" ] 2>/dev/null; then
        pass "$key = $val (min $min)"
    else
        fail "$key = $val (need >= $min)"
    fi
}

check_sysctl_eq() {
    key="$1"; expected="$2"
    val=$(read_sysctl "$key")
    if [ -z "$val" ]; then
        fail "$key: not found"
    elif [ "$val" -eq "$expected" ] 2>/dev/null; then
        pass "$key = $val"
    else
        fail "$key = $val (need $expected)"
    fi
}

# ── DNS ──────────────────────────────────────────────────────────────────────
section "DNS"
if nslookup www.google.com >/dev/null 2>&1; then
    pass "External DNS resolution works"
else
    fail "External DNS resolution failed (www.google.com)"
fi

# ── Swap ─────────────────────────────────────────────────────────────────────
section "Swap"
swap_lines=$(wc -l < /proc/swaps)
if [ "$swap_lines" -le 1 ]; then
    pass "Swap is disabled"
else
    fail "Swap is active: $(tail -n +2 /proc/swaps | awk '{print $1}' | tr '\n' ' ')"
fi

if [ -f /host/etc/fstab ] && grep -qE '^[^#].*[[:space:]]swap[[:space:]]' /host/etc/fstab; then
    warn "/etc/fstab has uncommented swap entry — will re-enable on reboot"
else
    pass "/etc/fstab swap entry is commented out or absent"
fi

# ── Kernel modules ────────────────────────────────────────────────────────────
section "Kernel Modules"
for mod in overlay br_netfilter; do
    if grep -q "^${mod} " /proc/modules; then
        pass "Module loaded: $mod"
    else
        fail "Module NOT loaded: $mod  (run: modprobe $mod)"
    fi
done

# ── Sysctl — networking ───────────────────────────────────────────────────────
section "Sysctl — Networking"
check_sysctl_eq  net.bridge.bridge-nf-call-iptables  1
check_sysctl_eq  net.bridge.bridge-nf-call-ip6tables 1
check_sysctl_eq  net.ipv4.ip_forward                 1
check_sysctl_eq  net.ipv4.tcp_fastopen               3

# ── Sysctl — inotify (minimum thresholds from install-k3s.sh) ────────────────
section "Sysctl — inotify (minimums)"
check_sysctl_min fs.inotify.max_user_instances 4096
check_sysctl_min fs.inotify.max_user_watches   8192
check_sysctl_min fs.inotify.max_queued_events  16384

# user.max_inotify_instances is a non-standard alias on some kernels
val=$(read_sysctl user.max_inotify_instances)
if [ -n "$val" ]; then
    if [ "$val" -ge 4096 ]; then
        pass "user.max_inotify_instances = $val (min 4096)"
    else
        fail "user.max_inotify_instances = $val (need >= 4096)"
    fi
else
    warn "user.max_inotify_instances: not present on this kernel (fs.inotify.max_user_instances is authoritative)"
fi

# ── File descriptor limits ────────────────────────────────────────────────────
section "File Descriptor Limits"
if [ -f /proc/1/limits ]; then
    soft=$(awk '/Max open files/ {print $4}' /proc/1/limits)
    hard=$(awk '/Max open files/ {print $5}' /proc/1/limits)
    if [ "$soft" = "unlimited" ] || [ "${soft:-0}" -ge 16384 ] 2>/dev/null; then
        pass "PID 1 soft nofile = $soft (min 16384)"
    else
        fail "PID 1 soft nofile = $soft (need >= 16384)"
    fi
    if [ "$hard" = "unlimited" ] || [ "${hard:-0}" -ge 32768 ] 2>/dev/null; then
        pass "PID 1 hard nofile = $hard (min 32768)"
    else
        fail "PID 1 hard nofile = $hard (need >= 32768)"
    fi
else
    warn "Cannot read /proc/1/limits"
fi

if [ -f /host/etc/security/limits.d/zhone.conf ]; then
    pass "/etc/security/limits.d/zhone.conf exists"
else
    warn "/etc/security/limits.d/zhone.conf missing — limits may not persist across logins"
fi

# ── Listening ports ───────────────────────────────────────────────────────────
# Parse /proc/net/tcp[6]: field $4=="0A" is LISTEN, $2 is local hex ip:port
section "Listening Ports"
for port in 6443 10250; do
    hex_port=$(printf '%04X' "$port")
    listening=0
    for f in /proc/net/tcp /proc/net/tcp6; do
        [ -f "$f" ] || continue
        if awk 'NR>1 && $4=="0A" {
                n = split($2, a, ":")
                if (toupper(a[n]) == "'"$hex_port"'") { found=1; exit }
               } END { exit !found }' "$f" 2>/dev/null; then
            listening=1
            break
        fi
    done
    if [ "$listening" -eq 1 ]; then
        pass "Port $port is listening"
    else
        warn "Port $port is not listening (k3s may still be starting)"
    fi
done

printf "\n${CYAN}══════════════════════════════════════════${NC}\n"
printf "  HOST Results:  ${GREEN}PASS: %d${NC}  ${RED}FAIL: %d${NC}  ${YELLOW}WARN: %d${NC}\n" \
    "$PASS" "$FAIL" "$WARN"
printf "${CYAN}══════════════════════════════════════════${NC}\n\n"

[ "$FAIL" -eq 0 ]
INNER_SCRIPT

# Create ConfigMap from the inner script file (shared by all pods)
kubectl create configmap "$CM_NAME" -n "$NAMESPACE" \
    --from-file=verify.sh="${TMPDIR_INNER}/verify.sh"

# run_host_checks <node-name-or-empty>
# Launches a privileged pod, streams its output, returns its exit code.
run_host_checks() {
    local target_node="$1"
    local display="${target_node:-"(scheduler decides)"}"

    # Sanitize node name for use in a pod name: lowercase, non-alnum -> hyphen
    local safe_node
    safe_node=$(echo "$target_node" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/-$//')
    local pod_name
    if [ -n "$safe_node" ]; then
        pod_name="${CM_NAME}-${safe_node}"
        # Pod names max 253 chars; trim if needed
        pod_name="${pod_name:0:63}"
    else
        pod_name="${CM_NAME}"
    fi
    CREATED_PODS+=("$pod_name")

    echo ""
    echo -e "${CYAN}━━━ Host checks: ${display} ━━━${NC}"

    # Apply privileged pod manifest.
    # dnsPolicy:Default uses the host's /etc/resolv.conf so the DNS check
    # reflects the node's actual resolver, not cluster CoreDNS.
    kubectl apply -n "$NAMESPACE" -f - <<EOF
apiVersion: v1
kind: Pod
metadata:
  name: ${pod_name}
  namespace: ${NAMESPACE}
spec:
  hostPID: true
  hostNetwork: true
  dnsPolicy: Default
  restartPolicy: Never
$([ -n "$target_node" ] && echo "  nodeName: ${target_node}")
  tolerations:
  - key: node-role.kubernetes.io/control-plane
    operator: Exists
    effect: NoSchedule
  - key: node-role.kubernetes.io/master
    operator: Exists
    effect: NoSchedule
  containers:
  - name: verify
    image: ${IMAGE}
    imagePullPolicy: IfNotPresent
    command: ["/bin/sh", "/scripts/verify.sh"]
    securityContext:
      privileged: true
    volumeMounts:
    - name: scripts
      mountPath: /scripts
    - name: host-etc
      mountPath: /host/etc
      readOnly: true
  volumes:
  - name: scripts
    configMap:
      name: ${CM_NAME}
      defaultMode: 0755
  - name: host-etc
    hostPath:
      path: /etc
EOF

    echo -e "${CYAN}Waiting for pod to start...${NC}"
    for i in $(seq 1 60); do
        local phase
        phase=$(kubectl get pod "$pod_name" -n "$NAMESPACE" \
            -o jsonpath='{.status.phase}' 2>/dev/null)
        case "$phase" in
            Running|Succeeded|Failed) break ;;
        esac
        sleep 2
    done

    local phase
    phase=$(kubectl get pod "$pod_name" -n "$NAMESPACE" \
        -o jsonpath='{.status.phase}' 2>/dev/null)
    if [ "$phase" = "Pending" ]; then
        echo -e "${RED}Pod is stuck in Pending — check image pull and node taints:${NC}"
        kubectl describe pod "$pod_name" -n "$NAMESPACE" | tail -20
        return 1
    fi

    kubectl logs -f "$pod_name" -n "$NAMESPACE" 2>/dev/null \
        || kubectl logs "$pod_name" -n "$NAMESPACE"

    # Wait for terminal state
    for i in $(seq 1 30); do
        phase=$(kubectl get pod "$pod_name" -n "$NAMESPACE" \
            -o jsonpath='{.status.phase}' 2>/dev/null)
        [ "$phase" = "Succeeded" ] || [ "$phase" = "Failed" ] && break
        sleep 2
    done

    local pod_exit
    pod_exit=$(kubectl get pod "$pod_name" -n "$NAMESPACE" \
        -o jsonpath='{.status.containerStatuses[0].state.terminated.exitCode}' 2>/dev/null)
    return "${pod_exit:-1}"
}

# ── Determine which nodes to check ───────────────────────────────────────────

if [ -n "$ALL_NODES" ]; then
    mapfile -t target_nodes < <(
        kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null
    )
    echo ""
    echo -e "${CYAN}Checking all ${#target_nodes[@]} node(s): ${target_nodes[*]}${NC}"
elif [ -n "$NODE" ]; then
    target_nodes=("$NODE")
else
    target_nodes=("")
fi

# ── Run host checks on each target node ──────────────────────────────────────

HOST_NODES_FAILED=0
for node in "${target_nodes[@]}"; do
    run_host_checks "$node" || HOST_NODES_FAILED=$((HOST_NODES_FAILED+1))
done

# ── Final summary ─────────────────────────────────────────────────────────────
echo ""
echo -e "${CYAN}══════════════════════════════════════════${NC}"
echo -e "  K8s Results:  ${GREEN}PASS: ${K8S_PASS}${NC}  ${RED}FAIL: ${K8S_FAIL}${NC}  ${YELLOW}WARN: ${K8S_WARN}${NC}"
if [ "${#target_nodes[@]}" -gt 1 ]; then
    nodes_ok=$(( ${#target_nodes[@]} - HOST_NODES_FAILED ))
    echo -e "  Host nodes:   ${GREEN}OK: ${nodes_ok}${NC}  ${RED}FAILED: ${HOST_NODES_FAILED}${NC} of ${#target_nodes[@]} total"
fi
echo -e "${CYAN}══════════════════════════════════════════${NC}"
echo ""

[ "${K8S_FAIL}" -eq 0 ] && [ "${HOST_NODES_FAILED}" -eq 0 ]
